# Copy to .env and adjust. The starter reads plain environment variables —
# there is no dotenv dependency, so either export these or use `node --env-file=.env`.

# Port the HTTP server listens on.
PORT=4000

# Bind address. 127.0.0.1 keeps it local; 0.0.0.0 exposes it on your network.
HOST=127.0.0.1

# SQLite file. Use :memory: for a throwaway database.
DATABASE_FILE=./data/app.db
