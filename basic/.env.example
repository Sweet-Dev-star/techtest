# Copy to .env at the repo root, or export these. Working defaults are built in.

# Port the API listens on. In production it also serves the built client.
PORT=4000

# Bind address. 127.0.0.1 keeps it local; 0.0.0.0 exposes it on your network.
HOST=127.0.0.1

# SQLite file. Use :memory: for a throwaway database (tests do this automatically).
DATABASE_FILE=./data/app.db

# Set to a long random string in production. Sessions survive a restart only if this is stable.
SESSION_SECRET=dev-only-not-a-secret

# Where the client dev server runs, so the API allows it through CORS in development.
CLIENT_ORIGIN=http://localhost:5173
